{
  "name": "delegua",
  "version": "1.12.6",
  "description": "Pacote NPM da Linguagem Delégua, com todas as bibliotecas oficiais e dialetos de Portugol e Potigol embarcados.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesignLiquido/delegua-completo.git"
  },
  "scripts": {
    "empacotar": "yarn rimraf ./dist && yarn copyfiles -V ./README.md ./dist && yarn copyfiles -V ./LICENSE ./dist",
    "publicar-npm": "npm publish --access public"
  },
